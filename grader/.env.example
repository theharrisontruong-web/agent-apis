# Copy to .env (never commit a real .env). All values are read at startup.
# No secrets are hardcoded in the codebase.

# Wallet that receives the USDC payments (Base). REQUIRED for paid mode.
X402_WALLET=0x0000000000000000000000000000000000000000

# Price per grade call, e.g. "$1.00". ~20 paid calls/month covers a $20/mo subscription.
X402_PRICE=$1.00

# CAIP-2 network id. Default eip155:84532 = Base Sepolia (testnet) — the only
# network the default x402.org facilitator supports for the exact scheme.
# For REAL money: point X402_FACILITATOR_URL at a mainnet facilitator and set
# X402_NETWORK=eip155:8453 (Base mainnet). See README "Going live on mainnet".
X402_NETWORK=eip155:84532

# x402 facilitator used to verify/settle payments.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional: Coinbase CDP facilitator (Bazaar rail). When BOTH vars below are
# set, a second accepts entry is offered whose payments verify/settle through
# Coinbase CDP — the rail the CDP Bazaar / agentic.market catalog indexes.
# Free keys at portal.cdp.coinbase.com (View permission is enough). PayAI
# stays the default rail; with either var unset, behavior is unchanged.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Set to 1 for local development: disables the paywall entirely (free calls).
X402_DISABLED=0

# Port the server listens on (honored by Dockerfile / fly.toml).
PORT=8000
